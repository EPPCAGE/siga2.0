rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    // Verifica Custom Claim {perfil} definido pela Cloud Function setUserClaims.
    // A função é chamada automaticamente após cada login. O token é renovado
    // com getIdToken(true) para que o claim fique disponível imediatamente.
    function isEP() {
      return isAuth() && request.auth.token.get('perfil', '') == 'ep';
    }

    // ---------------------------------------------------------------------------
    // config/ — leitura exige autenticação (leitura pública removida em PR #508).
    // Escrita restrita a EP: cadastro de usuários, configurações institucionais.
    // ---------------------------------------------------------------------------
    match /config/{docId} {
      allow read: if isAuth();
      allow write: if isEP();
    }

    // Processos: EP tem escrita plena. Não-EP pode atualizar dados do próprio
    // processo (questionário, POP etc.) mas NÃO pode alterar etapa nem status_ciclo
    // — campos que controlam o ciclo de vida e são validados só no servidor.
    match /processos/{procId} {
      allow read: if isAuth();
      allow create: if isEP();
      allow delete: if isEP();
      allow update: if isEP() ||
        (isAuth() &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['etapa', 'status_ciclo']));
    }

    // Publicações e metodologias: somente EP publica.
    match /publicacoes/{pubId} {
      allow read: if isAuth();
      allow write: if isEP();
    }

    // KPIs e relatórios: donos escrevem seus próprios indicadores.
    match /kpis/{id}          { allow read: if isAuth(); allow write: if isAuth(); }
    // Biblioteca compartilhada: usuários autenticados adicionam controles;
    // aplicações e avaliações ficam nos riscos, sem alterar o catálogo.
    match /controles_biblioteca/{id} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.keys().hasOnly(['nome', 'categoria', 'tipo', 'descricao', 'criado_em', 'autor_uid'])
        && request.resource.data.keys().hasAll(['nome', 'categoria', 'tipo', 'descricao', 'criado_em', 'autor_uid'])
        && request.resource.data.nome is string && request.resource.data.nome.size() > 0 && request.resource.data.nome.size() <= 200
        && request.resource.data.categoria is string && request.resource.data.categoria.size() > 0 && request.resource.data.categoria.size() <= 200
        && request.resource.data.descricao is string && request.resource.data.descricao.size() > 0 && request.resource.data.descricao.size() <= 5000
        && request.resource.data.tipo in ['Preventivo', 'Detectivo', 'Corretivo']
        && request.resource.data.autor_uid == request.auth.uid
        && request.resource.data.criado_em == request.time;
      allow update, delete: if false;
    }
    // Central de Controles: consulta institucional autenticada; gestão exclusiva do EP.
    match /central_controles/{id} {
      function validControl() {
        let d = request.resource.data;
        let common = ['nome', 'categoria', 'descricao', 'tipo', 'origem', 'processos_associados', 'autor_uid', 'criado_em', 'atualizado_em'];
        let legacy = ['setor', 'responsavel', 'efetividade'];
        return d.keys().hasAll(common)
          && d.keys().hasOnly(common.concat(legacy).concat(['schema_version', 'classificacao_anterior']))
          && d.nome is string && d.nome.size() > 0 && d.nome.size() <= 200
          && d.categoria is string && d.categoria.size() > 0 && d.categoria.size() <= 200
          && d.descricao is string && d.descricao.size() > 0 && d.descricao.size() <= 5000
          && d.tipo in ['Preventivo', 'Detectivo', 'Corretivo']
          && d.origem in ['Fábrica', 'Cadastrado', 'Mapeamento']
          && d.processos_associados is list && d.processos_associados.size() <= 500
          && d.autor_uid == request.auth.uid
          && d.criado_em is timestamp && d.atualizado_em == request.time
          && ((d.get('schema_version', 1) == 2 && !d.keys().hasAny(legacy)) ||
            (d.get('schema_version', 1) == 1 && d.keys().hasAll(legacy)
              && d.setor is string && d.setor.size() <= 200
              && d.responsavel is string && d.responsavel.size() <= 200
              && d.efetividade in ['Não avaliada', 'Eficaz', 'Parcialmente eficaz', 'Ineficaz']));
      }
      allow read: if isAuth();
      allow create: if isEP() && validControl() && request.resource.data.criado_em == request.time;
      allow update: if isEP() && validControl()
        && (resource.data.get('schema_version', 1) != 2 || request.resource.data.get('schema_version', 1) == 2)
        && request.resource.data.criado_em == resource.data.criado_em
        && request.resource.data.origem == resource.data.origem
        && (resource.data.origem != 'Fábrica' ||
          (request.resource.data.nome == resource.data.nome
           && request.resource.data.categoria == resource.data.categoria
           && request.resource.data.descricao == resource.data.descricao));
      allow delete: if false;
    }
    match /controles_aplicacoes/{id} {
      function validApplication() {
        let d = request.resource.data;
        return d.keys().hasAll(['controle_id', 'processo_id', 'setor', 'responsavel', 'efetividade', 'autor_uid', 'criado_em', 'atualizado_em'])
          && d.keys().hasOnly(['controle_id', 'processo_id', 'setor', 'responsavel', 'efetividade', 'autor_uid', 'criado_em', 'atualizado_em'])
          && d.controle_id is string && d.controle_id.size() > 0 && d.controle_id.size() <= 200
          && d.processo_id is string && d.processo_id.size() > 0 && d.processo_id.size() <= 200
          && d.setor is string && d.setor.size() <= 200
          && d.responsavel is string && d.responsavel.size() <= 200
          && d.efetividade in ['Não avaliada', 'Eficaz', 'Parcialmente eficaz', 'Ineficaz']
          && d.autor_uid == request.auth.uid
          && d.criado_em is timestamp && d.atualizado_em == request.time
          && getAfter(/databases/$(database)/documents/central_controles/$(d.controle_id)).data.schema_version == 2;
      }
      allow read: if isAuth();
      allow create: if isEP() && validApplication() && request.resource.data.criado_em == request.time;
      allow update: if isEP() && validApplication()
        && request.resource.data.controle_id == resource.data.controle_id
        && request.resource.data.criado_em == resource.data.criado_em;
      allow delete: if isEP();
    }

    match /relatorios_ind/{id}{ allow read: if isAuth(); allow write: if isAuth(); }

    // Conteúdo institucional gerenciado pelo EP.
    match /plano/{id}       { allow read: if isAuth(); allow write: if isEP(); }
    match /arquitetura/{id} { allow read: if isAuth(); allow write: if isEP(); }
    match /plano_metas/{id} { allow read: if isAuth(); allow write: if isEP(); }

    // Notificações: qualquer usuário autenticado envia/recebe.
    match /notifs/{id} { allow read: if isAuth(); allow write: if isAuth(); }

    // Registros vinculados à arquitetura: autor cria; EP registra a primeira leitura.
    match /registros_processos/{id} {
      allow read: if isAuth() && (isEP() || resource.data.autor_uid == request.auth.uid);
      allow create: if isAuth()
        && request.resource.data.keys().hasAll(['arq_id', 'processo_id', 'processo_nome', 'tipo', 'descricao', 'autor_uid', 'autor_email', 'autor_nome', 'criado_em', 'lido'])
        && request.resource.data.keys().hasOnly(['arq_id', 'processo_id', 'processo_nome', 'tipo', 'descricao', 'autor_uid', 'autor_email', 'autor_nome', 'criado_em', 'lido'])
        && request.resource.data.autor_uid == request.auth.uid
        && request.resource.data.autor_email == request.auth.token.email
        && request.resource.data.autor_nome is string && request.resource.data.autor_nome.size() > 0 && request.resource.data.autor_nome.size() <= 200
        && request.resource.data.arq_id is string && request.resource.data.arq_id.size() > 0 && request.resource.data.arq_id.size() <= 200
        && request.resource.data.processo_id is string && request.resource.data.processo_id.size() <= 200
        && request.resource.data.processo_nome is string && request.resource.data.processo_nome.size() > 0 && request.resource.data.processo_nome.size() <= 1000
        && request.resource.data.tipo in ['problema', 'sugestao', 'retrabalho', 'mapeamento', 'dificuldade']
        && request.resource.data.descricao is string && request.resource.data.descricao.size() > 0 && request.resource.data.descricao.size() <= 5000
        && request.resource.data.criado_em == request.time && request.resource.data.lido == false;
      allow update: if isEP() && resource.data.lido == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lido', 'lido_em', 'lido_por'])
        && request.resource.data.lido == true && request.resource.data.lido_em == request.time
        && request.resource.data.lido_por == request.auth.uid;
      allow delete: if false;
    }

    // Rascunhos de fluxos enviados por donos e gestores; revisão e publicação pelo EPP.
    match /mapeamentos_colaborativos/{id} {
      function eligibleAuthor() {
        return isAuth() && (isEP() || request.auth.token.get('perfil', '') in ['dono', 'gestor']
          || request.auth.token.get('perfis', []).hasAny(['dono', 'gestor']));
      }
      function validFlow() {
        let d = request.resource.data;
        return d.keys().hasAll(['autor_uid','autor_email','autor_nome','nome','macro_id','macro_nome','arq_id','tipo','objetivo','status','revisao','conteudo','aviso_lido','atualizado_em'])
          && d.keys().hasOnly(['autor_uid','autor_email','autor_nome','nome','macro_id','macro_nome','arq_id','tipo','objetivo','status','revisao','conteudo','aviso_lido','atualizado_em','publicacao_id','revisor_uid','observacoes_revisao'])
          && d.autor_uid is string && d.autor_email is string
          && d.autor_nome is string && d.autor_nome.size() > 0 && d.autor_nome.size() <= 200
          && d.nome is string && d.nome.size() > 0 && d.nome.size() <= 240
          && d.macro_id is string && d.macro_id.size() > 0 && d.macro_id.size() <= 200
          && d.macro_nome is string && d.macro_nome.size() <= 1000
          && d.arq_id is string && d.arq_id.size() <= 200
          && d.tipo in ['asis','tobe'] && d.status in ['rascunho','enviado','publicado']
          && d.objetivo is string && d.objetivo.size() > 0 && d.objetivo.size() <= 3000
          && d.revisao is int && d.revisao > 0 && d.aviso_lido is bool
          && d.conteudo is string && d.conteudo.size() <= 700000
          && d.atualizado_em is string && d.atualizado_em.size() <= 30;
      }
      function immutableAuthor() {
        return request.resource.data.autor_uid == resource.data.autor_uid
          && request.resource.data.autor_email == resource.data.autor_email
          && request.resource.data.autor_nome == resource.data.autor_nome
          && request.resource.data.tipo == resource.data.tipo;
      }
      allow read: if isAuth() && ((isEP() && resource.data.status in ['enviado','publicado']) || resource.data.autor_uid == request.auth.uid);
      allow create: if eligibleAuthor() && validFlow()
        && request.resource.data.autor_uid == request.auth.uid
        && request.resource.data.autor_email == request.auth.token.email
        && request.resource.data.status == 'rascunho' && request.resource.data.revisao == 1
        && request.resource.data.aviso_lido == false
        && !request.resource.data.keys().hasAny(['publicacao_id','revisor_uid','observacoes_revisao']);
      allow update: if isAuth() && validFlow() && immutableAuthor() && (
        (resource.data.autor_uid == request.auth.uid && eligibleAuthor()
          && resource.data.status == 'rascunho' && request.resource.data.status in ['rascunho','enviado']
          && request.resource.data.revisao == resource.data.revisao + 1
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['conteudo','status','revisao','atualizado_em']))
        || (isEP() && resource.data.status == 'enviado'
          && request.resource.data.status in ['enviado','publicado']
          && request.resource.data.revisao == resource.data.revisao + 1
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['conteudo','status','revisao','atualizado_em','arq_id','macro_id','macro_nome','publicacao_id','aviso_lido','revisor_uid','observacoes_revisao'])
          && (request.resource.data.status == 'enviado' || (
            request.resource.data.arq_id.size() > 0 && request.resource.data.revisor_uid == request.auth.uid
            && request.resource.data.aviso_lido == false
            && getAfter(/databases/$(database)/documents/publicacoes/$(string(request.resource.data.publicacao_id))).data.fluxo_colaborativo.origem_id == id
            && getAfter(/databases/$(database)/documents/publicacoes/$(string(request.resource.data.publicacao_id))).data.fluxo_colaborativo.conteudo == request.resource.data.conteudo)))
        || (resource.data.autor_uid == request.auth.uid && resource.data.status == 'publicado'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['aviso_lido']) && request.resource.data.aviso_lido == true));
      allow delete: if false;
    }

    // Sessões: cada usuário acessa apenas a própria.
    match /sessions/{uid} {
      allow read, write: if isAuth() && request.auth.uid == uid;
    }

    // Projetos: gerentes e EP escrevem.
    match /projPROJETOS/{id}  { allow read: if isAuth(); allow write: if isAuth(); }

    // Programas: criados e mantidos pelo EP.
    match /projPROGRAMAS/{id} { allow read: if isAuth(); allow write: if isEP(); }

    // Documento do usuário: cada um escreve apenas no próprio.
    match /usuarios/{uid} {
      allow read: if isAuth();
      allow write: if isAuth() && request.auth.uid == uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
